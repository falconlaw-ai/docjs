{
  "name": "docx-preview-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "pnpm copy-assets && vite --host 127.0.0.1 --port 4176 --strictPort",
    "build": "pnpm copy-assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "docx-preview": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
